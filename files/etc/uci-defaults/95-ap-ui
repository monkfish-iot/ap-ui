# AP-UI · 首次安装 / 首次启动（uci-defaults）
#
# 1) 把站点根 /www/index.html 改写为「跳转到 ap-ui」的入口页。
#    该文件在固件里归 luci-base 所有，apk 禁止跨包覆盖（见 Makefile 说明），
#    故不能在 Package/ap-ui/install 里安装它，只能在首启时用脚本改写。
#    LuCI 仍可从 /cgi-bin/luci/ 进入（本页保留了链接）。
# 2) 重启 rpcd 以加载新的 ucode 插件与 ACL。
#
# 幂等，uci-defaults 执行后本脚本会自动移除。

cat > /www/index.html <<'APUI_INDEX'
<!DOCTYPE html>
<html>
	<head>
		<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
		<meta http-equiv="Pragma" content="no-cache" />
		<meta http-equiv="Expires" content="0" />
		<meta http-equiv="refresh" content="0; URL=apui/index.html" />
		<style>
			body { background: white; font-family: arial, helvetica, sans-serif; }
			a { color: black; }

			@media (prefers-color-scheme: dark) {
				body { background: black; }
				a { color: white; }
			}
		</style>
	</head>
	<body>
		<a href="apui/index.html">AP 管理界面</a>
		<br>
		<a href="cgi-bin/luci/">LuCI - Lua Configuration Interface</a>
	</body>
</html>
APUI_INDEX

[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd restart

exit 0